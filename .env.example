# Stratum-Memory — example environment file.
# Copy to `.env` (next to the repo root) and edit. NEVER commit the real `.env`.
# All application settings use the STRATUM_ prefix; a few compose conveniences
# use short names (see the notes).

# ---- database -------------------------------------------------------------
# Set by the compose file; shown here for reference.
# STRATUM_DB_HOST=stratum-db
# STRATUM_DB_NAME=stratum
# STRATUM_DB_USER=stratum_app
# STRATUM_DB_PASSWORD_FILE=/run/secrets/app_password

# ---- LLM / embeddings -----------------------------------------------------
# Chat + embedding endpoint (OpenAI-compatible). Point this at your provider.
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small

# Optional separate embedding endpoint (e.g. a local Ollama, unlimited and
# private). Leave empty to reuse LLM_BASE_URL. Must produce 1024-dim vectors.
# STRATUM_LLM_EMBED_BASE_URL=http://host.docker.internal:11434/v1

# ---- host bind ------------------------------------------------------------
# Host address the MCP HTTP port is published on. 127.0.0.1 = localhost only.
# STRATUM_BIND_IP=127.0.0.1

# ---- Pi data root ---------------------------------------------------------
# Where the SSD data lives (Postgres + vault + backups).
# STRATUM_DATA_ROOT=/mnt/ssd/stratum