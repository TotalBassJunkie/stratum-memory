# Normalize line endings so cross-platform checkouts never break scripts.
# Shell scripts and SQL/conf files MUST stay LF: a stray CR ("\r") makes
# `set -euo pipefail` fail on Linux ("invalid option name") and corrupts
# Postgres init scripts. This bit us once; .gitattributes makes it permanent.

* text=auto eol=lf

# Explicit LF for executable/ops artifacts, even if a Windows editor adds CR.
*.sh    text eol=lf
*.ps1   text eol=crlf
*.sql   text eol=lf
*.conf  text eol=lf
Dockerfile   text eol=lf
Caddyfile    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.py    text eol=lf
*.md    text eol=lf

# Binary artifacts are never touched.
*.png   binary
*.jpg   binary
*.ico   binary
*.gz    binary
*.dump  binary

# SVG is text (keep LF for clean diffs).
*.svg   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
