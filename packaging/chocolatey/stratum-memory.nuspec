<?xml version="1.0" encoding="utf-8"?>
<!--
  Chocolatey package for Stratum-Memory.

  Contract: docs/distribution.md. The WiX MSI attached to the GitHub Release is
  installed silently by tools/chocolateyinstall.ps1. The version, the download
  URL and the checksum are rewritten by .github/workflows/release.yml on every
  tag; do not hand-edit them in the community feed.

  The <file> glob below must keep matching the real layout: `choco pack` copies
  only what it matches, so a script outside tools/ would silently be dropped
  from the nupkg. tools/chocolateyinstall.ps1 is the single install script.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>stratum-memory</id>
    <version>0.1.0</version>
    <title>Stratum-Memory</title>
    <authors>TotalBassJunkie</authors>
    <owners>TotalBassJunkie</owners>
    <projectUrl>https://github.com/TotalBassJunkie/stratum-memory</projectUrl>
    <packageSourceUrl>https://github.com/TotalBassJunkie/stratum-memory/tree/main/packaging/chocolatey</packageSourceUrl>
    <iconUrl>https://raw.githubusercontent.com/TotalBassJunkie/stratum-memory/main/assets/logo/stratum-logo.png</iconUrl>
    <licenseUrl>https://github.com/TotalBassJunkie/stratum-memory/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <docsUrl>https://github.com/TotalBassJunkie/stratum-memory/blob/main/docs/distribution.md</docsUrl>
    <bugTrackerUrl>https://github.com/TotalBassJunkie/stratum-memory/issues</bugTrackerUrl>
    <tags>stratum-memory stratum ai memory mcp cli knowledge-base postgres pgvector context</tags>
    <summary>Unified AI memory and context system (4 layers, ECL ingestion, curator gate, MCP API).</summary>
    <description>
Stratum-Memory is a unified AI memory and context system built on a single
namespace (stratum://&lt;bereich&gt;/&lt;tenant&gt;/&lt;pfad&gt;) over four layers: a
Git-versioned filesystem vault (L0-L2), a bi-temporal fact/entity graph, a
pgvector-backed vector and KV layer, and a budgeted reflect/synthesis worker.

An ECL ingestion pipeline (Extract -&gt; Cognify -&gt; Load) stages every candidate and a
curator validation gate is the only bridge into the active tables, so nothing is
promoted without review. The MCP-compatible tool API is the agent surface.

The `stratum` CLI bootstraps and drives the Docker stack (install, up, down,
status, logs, mcp, health, version, doctor). The stack runs identically on a
Raspberry Pi 4 (8 GB) and on a multi-tenant server.
    </description>
    <releaseNotes>https://github.com/TotalBassJunkie/stratum-memory/releases/tag/v0.1.0</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
